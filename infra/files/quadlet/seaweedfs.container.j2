# Managed by infra/playbooks/22-containers.yml, do not edit by hand
[Unit]
Description=SeaweedFS (OSS911 dev)
After=network-online.target
Wants=network-online.target

[Container]
Image={{ _sw_image }}
ContainerName=seaweedfs
Network=internal
PublishPort=127.0.0.1:{{ seaweedfs_master_port }}:9333
PublishPort=127.0.0.1:{{ seaweedfs_filer_port }}:8888
PublishPort=127.0.0.1:{{ seaweedfs_s3_port }}:8333
# Data lives on its own volume (00-base asserts the mount point exists)
Volume={{ seaweedfs_dir }}:/data:Z
# Single-node server mode: master + volume + filer + S3 in one.
# Production has three nodes with a different topology, but object keys and the S3 interface are the same (LD-08).
Exec=server -dir=/data -s3 -filer -master.volumeSizeLimitMB=1024

[Service]
Restart=on-failure
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
