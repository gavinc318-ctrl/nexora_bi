# Managed by infra/playbooks/22-containers.yml, do not edit by hand
#
# Quadlet: the container is managed as a systemd unit (the supported way since podman 4.4).
# Not started with podman run, and not with the deprecated podman generate systemd --
# start at boot, dependency order and restart policy are left to systemd: one less home-made script in an offline rebuild.
[Unit]
Description=Keycloak (OSS911 dev)
After=network-online.target postgresql@{{ postgres_version }}-{{ pg_cluster_name }}.service pgbouncer.service haproxy.service
Wants=network-online.target

[Container]
Image={{ _kc_image }}
ContainerName=keycloak
Network=internal
# Loopback only: there is no reverse proxy on the development machine, so it must not appear on the network
PublishPort=127.0.0.1:{{ keycloak_http_port }}:8080
PublishPort=127.0.0.1:{{ keycloak_mgmt_port }}:9000
EnvironmentFile=/etc/oss911/keycloak.env
Environment=KC_DB=postgres
# Connects to the host's pgBouncer, not to PostgreSQL itself (DD-67).
# The pool mode is decided by the database name: the keycloak entry in pgbouncer.ini is session --
# Keycloak uses a JDBC pool and prepared statements, which transaction pooling does not keep on the same backend connection.
Environment=KC_DB_URL=jdbc:postgresql://{{ podman_internal_gateway }}:{{ pgb_listen_port }}/{{ keycloak_db }}
Environment=KC_HEALTH_ENABLED=true
Environment=KC_HOSTNAME_STRICT=false
# start-dev is the development form: no TLS, no strict hostname check.
# Production uses start --optimized with certificates and hostname; that is LD-08's territory.
Exec=start-dev
# No in-container health check: the image is based on UBI micro without curl, and /dev/tcp is a bash feature,
# not an sh feature -- a health check that cannot run by itself only makes the status harder to read.
# The real verification is on the playbook side (the three asserts in 22-containers).

[Service]
Restart=on-failure
# Back-off: when Keycloak cannot reach the database it crashes repeatedly, and each start burns over a minute of CPU.
# Without back-off it restarts forever, hiding the problem while occupying a whole core.
# Give up after three failures within five minutes so systemctl status shows failed directly --
# a clear "failed" is far more useful than a fake-alive "restarting".
RestartSec=20
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
