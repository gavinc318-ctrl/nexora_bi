# Managed by infra/playbooks/30-python.yml, do not edit by hand
AIRFLOW_HOME={{ airflow_home }}
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
# The metadata database is reached through the host pgBouncer's airflow database (session pool) --
# applications never connect to PostgreSQL directly (DD-67). Airflow uses a SQLAlchemy pool and relies on session state,
# so, like dbt, it uses session pooling.
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://{{ airflow_db }}:{{ _af_db_password }}@127.0.0.1:{{ pgb_listen_port }}/{{ airflow_db }}
# Shared keys, the same on every node (DD-85 note · LD-08 3.3); see 30-python.yml. Rotation: runbook/91
AIRFLOW__API_AUTH__JWT_SECRET={{ _af_jwt_secret }}
AIRFLOW__CORE__FERNET_KEY={{ _af_fernet_key }}
AIRFLOW__LOGGING__BASE_LOG_FOLDER={{ airflow_home }}/logs
AIRFLOW__CORE__DAGS_FOLDER={{ airflow_home }}/dags
# Where running tasks report to (Airflow 3 task execution API). It must follow the API server's port: the
# default is http://localhost:8080/execution/, and 8080 is Keycloak here -- every task was killed at its first
# report with Keycloak's "Unable to find matching target resource method" (troubleshooting entry 31).
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://127.0.0.1:{{ airflow_api_port }}/execution/
# Silence exactly one warning, matched by its text: every "airflow dags ..." command prints "Could not import graphviz".
# graphviz only renders DAG images (airflow dags show) -- not used here, and not worth a new dependency
# (MANIFEST and licence review). All other warnings still show.
# Quoted because the value has spaces: this file is read both by systemd (EnvironmentFile) and by shells
# ("set -a; . airflow.env"); unquoted, a shell assigns "ignore:Could" and tries to run "not" as a command.
PYTHONWARNINGS="ignore:Could not import graphviz:UserWarning"
# Timezone: same as system_timezone; "today" must be the same day for reports and for scheduling
AIRFLOW__CORE__DEFAULT_TIMEZONE={{ system_timezone }}
