# Managed by infra/playbooks/30-python.yml, do not edit by hand
AIRFLOW_HOME={{ airflow_home }}
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
# The metadata database is reached through the host pgBouncer's airflow database (session pool) --
# applications never connect to PostgreSQL directly (DD-67). Airflow uses a SQLAlchemy pool and relies on session state,
# so, like dbt, it uses session pooling.
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://{{ airflow_db }}:{{ _af_db_password }}@127.0.0.1:{{ pgb_listen_port }}/{{ airflow_db }}
AIRFLOW__LOGGING__BASE_LOG_FOLDER={{ airflow_home }}/logs
AIRFLOW__CORE__DAGS_FOLDER={{ airflow_home }}/dags
# Timezone: same as system_timezone; "today" must be the same day for reports and for scheduling
AIRFLOW__CORE__DEFAULT_TIMEZONE={{ system_timezone }}
