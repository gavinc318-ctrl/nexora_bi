# 由 infra/playbooks/22-containers.yml 管理，勿手改
#
# 开发机上先只采自己与 HAProxy。库与业务组件的 exporter 随各自组件上线时再加——
# 采集目标写在这里而不是散落各处，是为了让「监控覆盖了什么」只有一个答案。
global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    env: dev
    site: MAK

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['127.0.0.1:9090']

  # HAProxy 的统计页只绑了宿主机回环，容器里要走网关地址
  - job_name: haproxy
    metrics_path: /metrics
    static_configs:
      - targets: ['{{ podman_internal_gateway }}:{{ haproxy_stats_port }}']
