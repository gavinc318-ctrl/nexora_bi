# Managed by infra/playbooks/22-containers.yml, do not edit by hand
#
# On the development machine scrape only itself and HAProxy for now. Exporters for the database and business components are added as each component goes live --
# targets live here rather than scattered around, so that "what does monitoring cover" has exactly one answer.
global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    env: dev
    site: MAK

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['127.0.0.1:9090']

  # HAProxy's stats page is bound to the host loopback only; from the container use the gateway address
  - job_name: haproxy
    metrics_path: /metrics
    static_configs:
      - targets: ['{{ podman_internal_gateway }}:{{ haproxy_stats_port }}']
