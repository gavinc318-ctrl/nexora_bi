# OSS911 development PostgreSQL parameters
# Generated by infra/playbooks/20-database.yml from files/postgresql-oss911.conf.j2, do not edit by hand
#
# * These are DEVELOPMENT values. The production database VMs are dedicated and follow RS-01 (no overcommit,
#   100% memory reservation, no swap) with a separate set; do not copy this file there.
#   This machine also runs Superset, Airflow and front-end builds, and memory must be left for them.

# ---- Memory ----
# 64 GB here, but not a dedicated database host. shared_buffers is 8 GB rather than the usual 25% (16 GB),
# leaving room for the other components; effective_cache_size is a planner hint, not an allocation.
shared_buffers = 8GB
effective_cache_size = 24GB
maintenance_work_mem = 1GB
work_mem = 32MB

# ---- Connections ----
# Applications always go through pgBouncer (21-connection.yml), so direct connections need not be many.
max_connections = 100

# ---- WAL ----
# WAL is on its own volume (see the volume table in 00-base). Separate for troubleshooting:
# WAL filling up and data filling up are two failures; on one volume both look like "disk full".
wal_level = replica
max_wal_size = 4GB
min_wal_size = 1GB
checkpoint_completion_target = 0.9

# ---- Timezone: same as the system ----
# Day cut-over, period closing and attribution by closing date all depend on it. Using UTC in development would
# hide a whole class of definition defects during development (DD-53 · LD-03 chapter 4).
timezone = '{{ system_timezone }}'
log_timezone = '{{ system_timezone }}'

# ---- Logging: for troubleshooting, generous in development ----
logging_collector = on
log_directory = 'log'
log_filename = 'postgresql-%Y-%m-%d.log'
log_rotation_age = 1d
log_line_prefix = '%m [%p] %q%u@%d '
log_checkpoints = on
log_connections = on
log_disconnections = on
log_lock_waits = on
log_temp_files = 0
# Development logs every statement slower than 200ms, to catch queries that are correct but inefficient early
log_min_duration_statement = 200

# ---- Timeouts: stop one forgotten open transaction from blocking cleanup ----
# The cost of a long transaction on the analytics replica is not "that query is slow" but blocked cleanup on the
# primary, piling WAL and growing disks -- one person's oversight hits the write side through replication. A hard timeout is the only reliable defence.
statement_timeout = 0
idle_in_transaction_session_timeout = 300000

# ---- Planner: SSD ----
random_page_cost = 1.1
effective_io_concurrency = 200

# ---- Autovacuum: many partitioned tables, so a little tighter ----
autovacuum_max_workers = 4
autovacuum_naptime = 30s

# Listen addresses come from inventory: localhost on the development machine (everything on one host, loopback suffices);
# in production pgBouncer and HAProxy are on the LB VMs and the database on its own VM, so it must listen on the internal address.
#
# * Do not list the podman bridge gateway address here. The bridge only exists while a container is attached,
#   and systemd starts postgresql before the containers; PG skips addresses it cannot bind and carries on,
#   so it "starts fine" with one address missing, on every boot. Containers always go through pgBouncer (DD-67).
listen_addresses = '{{ pg_listen_addresses }}'
