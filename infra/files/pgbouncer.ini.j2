;; 由 infra/playbooks/21-connection.yml 管理，勿手改
;;
;; 两个池的分工见 DD-67：
;;   oss911       事务级，门户查询 / Superset / 服务层接口
;;   oss911_etl   会话级，Airflow / dbt / 人工运维
;;
;; 后端一律指向本机 HAProxy，不直接指向 PostgreSQL。
;; pgBouncer 自己没有选主能力，知道谁是主库的是 Patroni，HAProxy 读它的健康检查。

[databases]
{{ pg_database }}     = host=127.0.0.1 port={{ haproxy_listen_port }} dbname={{ pg_database }} pool_mode=transaction pool_size={{ pgb_pool_size_txn }} reserve_pool={{ pgb_reserve_pool }}
{{ pg_database }}_etl = host=127.0.0.1 port={{ haproxy_listen_port }} dbname={{ pg_database }} pool_mode=session     pool_size={{ pgb_pool_size_session }}

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = {{ pgb_listen_port_txn }}
auth_type = scram-sha-256
auth_file = /etc/pgbouncer/userlist.txt
admin_users = pgbouncer
stats_users = pgbouncer, monitoring

;; 默认事务级。单个库上的 pool_mode 覆盖本项。
pool_mode = transaction

;; max_client_conn 是客户端侧，可以大；真正稀缺的是后端。
max_client_conn = {{ pgb_max_client_conn }}
default_pool_size = {{ pgb_pool_size_txn }}
reserve_pool_size = {{ pgb_reserve_pool }}
reserve_pool_timeout = 3

;; ★ 这一条是全局硬闸。default_pool_size 是「每个 (用户, 数据库) 组合」的大小，
;;   不是全局上限——三个用户连同一个库就是三个池。没有这一行，池数一多会悄悄超过
;;   PostgreSQL 的 max_connections，表现为库侧随机拒连。
max_db_connections = {{ pgb_max_db_connections }}
max_user_connections = {{ pgb_max_db_connections }}

;; 切换后的回收：主库易主时，指向旧主的服务端连接必须尽快报废重建。
;; 按日考核每天只有 0.86 秒容差，连接悬挂几十秒会直接吃光当天预算。
server_check_query = select 1
server_check_delay = 10
server_lifetime = 600
server_idle_timeout = 180
server_connect_timeout = 5
server_login_retry = 2

;; 事务级池化下不要让客户端以为自己持有会话状态
ignore_startup_parameters = extra_float_digits,options

log_connections = 0
log_disconnections = 0
log_pooler_errors = 1
