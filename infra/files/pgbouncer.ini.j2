;; Managed by infra/playbooks/21-connection.yml, do not edit by hand
;;
;; Pool mode is chosen by database name -- this instance has one listen port, and the database name a client connects to decides the pool mode.
;; Division of work, see DD-67:
;;   oss911       session, dbt / the ingestion program / manual operations. Named exactly like the database: dbt writes
;;                every relation as "database.schema.table" from its connection's database name, and PostgreSQL rejects
;;                any other name as a cross-database reference (DD-93)
;;   oss911_txn   transaction, portal queries / Superset / service layer APIs
;;   keycloak     session, Keycloak's JDBC pool (prepared statements need the same backend connection)
;;   airflow      session, Airflow's metadata database
;;   cad_mirror   session, DS's sync program writing the CAD mirror (DD-90)
;;
;; Backends always point to the local HAProxy, never directly to PostgreSQL.
;; pgBouncer cannot elect a primary; Patroni knows which node is primary, and HAProxy reads its health check.

[databases]
{{ pg_database }}     = host=127.0.0.1 port={{ haproxy_listen_port }} dbname={{ pg_database }} pool_mode=session     pool_size={{ pgb_pool_size_session }}
{{ pg_database }}_txn = host=127.0.0.1 port={{ haproxy_listen_port }} dbname={{ pg_database }} pool_mode=transaction pool_size={{ pgb_pool_size_txn }} reserve_pool={{ pgb_reserve_pool }}
{{ keycloak_db }}     = host=127.0.0.1 port={{ haproxy_listen_port }} dbname={{ keycloak_db }} pool_mode=session     pool_size={{ pgb_pool_size_keycloak }}
{{ airflow_db }}      = host=127.0.0.1 port={{ haproxy_listen_port }} dbname={{ airflow_db }}  pool_mode=session     pool_size={{ pgb_pool_size_airflow }}
{{ cad_mirror_db }}   = host=127.0.0.1 port={{ haproxy_listen_port }} dbname={{ cad_mirror_db }} pool_mode=session pool_size={{ pgb_pool_size_cad_mirror }}

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = {{ pgb_listen_port }}
;; hba: pgbouncer_hba.conf decides per pool and login -- mismatches are rejected, everything else uses SCRAM (DD-93)
auth_type = hba
auth_hba_file = {{ pgb_conf_dir }}/pgbouncer_hba.conf
;; userlist holds only pgbouncer itself. Every other user is looked up via auth_query --
;; otherwise each new database user would need a password hash copied into userlist, one more copy to drift out of sync.
auth_file = /etc/pgbouncer/userlist.txt
auth_user = pgbouncer
auth_query = SELECT * FROM public.pgbouncer_get_auth($1)
;; By default auth_query runs in the database the client connects to, which would need the function in every database.
;; With auth_dbname it runs in this one database only, and the function exists in one place.
auth_dbname = {{ pg_database }}
admin_users = pgbouncer
stats_users = pgbouncer, monitoring

;; Transaction mode by default. A per-database pool_mode overrides this.
pool_mode = transaction

;; max_client_conn is the client side and can be large; the scarce resource is the backend.
max_client_conn = {{ pgb_max_client_conn }}
default_pool_size = {{ pgb_pool_size_txn }}
reserve_pool_size = {{ pgb_reserve_pool }}
reserve_pool_timeout = 3

;; * This is the global hard cap. default_pool_size is the size per (user, database) pair,
;;   not a global limit -- three users on one database means three pools. Without this line, many pools silently exceed
;;   PostgreSQL's max_connections, which shows up as random connection refusals on the database side.
max_db_connections = {{ pgb_max_db_connections }}
max_user_connections = {{ pgb_max_db_connections }}

;; Recovery after failover: when the primary changes, server connections to the old primary must be discarded and rebuilt quickly.
;; The daily SLA allows only 0.86 seconds a day; connections hanging for tens of seconds use up the whole day's budget.
server_check_query = select 1
server_check_delay = 10
server_lifetime = 600
server_idle_timeout = 180
server_connect_timeout = 5
server_login_retry = 2

;; Under transaction pooling, do not let clients believe they hold session state
ignore_startup_parameters = extra_float_digits,options

log_connections = 0
log_disconnections = 0
log_pooler_errors = 1
