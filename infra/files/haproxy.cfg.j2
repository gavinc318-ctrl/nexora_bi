# Managed by infra/playbooks/21-connection.yml, do not edit by hand
#
# Backend of the local pgBouncer. One job only: deliver connections to the CURRENT primary.
#
# * In production the health check must use Patroni's REST /primary, never a TCP port probe.
#   A replica's 5432 is open just the same; a TCP probe sends write traffic to a read-only replica, and the symptom is the application
#   randomly reporting "cannot execute INSERT in a read-only transaction" -- it looks like an application bug,
#   but the health check method is wrong.
#   The development machine has no Patroni, so it falls back to {{ haproxy_health_check }}; this part is not production.

global
    log /dev/log local0
    maxconn 2000
    user haproxy
    group haproxy
    daemon

defaults
    log     global
    mode    tcp
    option  tcplog
    timeout connect 5s
    timeout client  30m          # session pool connections may idle for a long time; do not cut them on an HTTP time scale
    timeout server  30m
    retries 2

listen stats
    mode http
    bind 127.0.0.1:{{ haproxy_stats_port }}
    stats enable
    stats uri /
    stats refresh 5s

listen pg_primary
    bind 127.0.0.1:{{ haproxy_listen_port }}
    option {{ haproxy_health_check }} user {{ haproxy_check_user | default('postgres') }}
    # on-marked-down shutdown-sessions: when a node is marked down, its connections are cut immediately
    # instead of hanging until the TCP timeout. During failover this decides between recovery in seconds or minutes.
{% for h in haproxy_backends %}
    server {{ h.name }} {{ h.addr }} check inter 2s fall 2 rise 2 on-marked-down shutdown-sessions
{% endfor %}
