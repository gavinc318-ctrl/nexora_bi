# Managed by infra/playbooks/60-svc.yml, do not edit by hand
# The query API (DD-99). Its settings are read by the program itself from /etc/oss911/svc.conf and svc.env
# (src/svc/src/oss911_svc/config.py): nothing secret passes through this unit.
[Unit]
Description=OSS911 BI query API (dev)
After=network-online.target pgbouncer.service
Wants=network-online.target
# Restart limits belong to [Unit]: in [Service] systemd ignores StartLimitIntervalSec (and the limit fell back to 10 s)
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=oss911svc
Group=oss911svc
WorkingDirectory=/var/lib/oss911svc
ExecStart={{ venv_root }}/venv-svc/bin/uvicorn --factory oss911_svc.app:serve --host {{ svc_listen }} --port {{ svc_port }} --no-server-header
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
# Least privilege: the service reads its settings and talks over the network, nothing else
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/oss911svc

[Install]
WantedBy=multi-user.target
