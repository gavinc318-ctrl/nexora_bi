# Managed by infra/playbooks/30-python.yml, do not edit by hand
#
# dbt uses pgBouncer's session pool (database name {{ pg_database }}_etl).
# On the transaction pool dbt's temporary tables, SET and advisory locks fail at random --
# not always but occasionally, which is why the database name must be right here (DD-67).
#
# threads must not exceed the session pool size {{ pgb_pool_size_session }}: exceeding it raises no error,
# it queues on the pool and looks like "dbt hangs without any error".
oss911:
  target: dev
  outputs:
    dev:
      type: postgres
      host: 127.0.0.1
      port: {{ pgb_listen_port }}
      user: "{{ '{{ env_var(\'DBT_USER\') }}' }}"
      password: "{{ '{{ env_var(\'DBT_PASSWORD\') }}' }}"
      dbname: {{ pg_database }}_etl
      # After connecting, SET ROLE to the privilege role so that tables built by dbt belong to oss911_transform.
      # Without it the owner is the login user, the FOR ROLE oss911_transform default privileges of 0002 do not apply,
      # and the service layer cannot read mart (DD-74 · LD-02 13.2). Do not remove this line.
      role: oss911_transform
      schema: staging
      threads: {{ pgb_pool_size_session }}
      keepalives_idle: 0
      connect_timeout: 10
