  "info": {
    "description": "Metrics by dimensions over the published mart tables (DD-99 · LD-04 3.5). Every response or refusal is audited; refusals carry their own error code.",
    "title": "OSS911 BI query API",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/dimensions/{dimension}/members": {
      "get": {
        "operationId": "members_v1_dimensions__dimension__members_get",
        "parameters": [
          {
            "description": "A dimension of the metric's table",
            "in": "path",
            "name": "dimension",
            "required": true,
            "schema": {
              "description": "A dimension of the metric's table",
              "title": "Dimension",
              "type": "string"
            }
          },
          {
            "description": "The metric whose table the members come from",
            "in": "query",
            "name": "metric",
            "required": true,
            "schema": {
              "description": "The metric whose table the members come from",
              "title": "Metric",
              "type": "string"
            }
          },
          {
            "description": "Default: 31 days before to",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Default: 31 days before to",
              "title": "From"
            }
          },
          {
            "description": "Exclusive; default: tomorrow (Asia/Riyadh)",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
